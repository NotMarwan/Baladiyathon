fable-orchestrator/.pytest_cache/
.pytest_cache/

# ── Runtime / local-only state (not source) ─────────────────────
# سجل القرارات الثابت: بيانات تشغيل لا مصدر.
.masar/
.athar/
logs/
tmp/
presentation/server_log.txt
presentation/tests/shots/

# ── Regenerated artifacts ───────────────────────────────────────
# graphify cache يُعاد بناؤه بـ `graphify update` — لا يُتتبّع.
# graph.json و GRAPH_REPORT.md و manifest.json تبقى متتبَّعة (محرك التنقل).
graphify-out/cache/

# ── مخلّفات ويندوز ──────────────────────────────────────────────
# NUL اسم جهاز محجوز في ويندوز: وجوده كملف يكسر الاستنساخ.
presentation/NUL
